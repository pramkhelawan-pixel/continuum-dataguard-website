---
import Container from '../ui/Container.astro';

const currentYear = new Date().getFullYear();

const siteMap = [
  { label: 'Pillars', href: '/#pillars' },
  { label: 'How We Work', href: '/#how-we-work' },
  { label: 'Organisational Development', href: '/#organisational-development' },
  { label: 'Neptune', href: '/#neptune' },
  { label: 'Insights', href: '/#insights' },
  { label: 'Contact', href: '/#contact-cta' },
];

const legal = [
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Terms of Use', href: '/terms' },
];
---

<footer class="border-t border-border bg-void">
  <Container class="grid gap-12 py-16 md:grid-cols-2">
    <div>
      <p class="font-mono text-sm uppercase tracking-widest text-paper">
        Continuum Dataguard Technologies
      </p>
      <div class="mt-4 flex flex-col gap-2">
        <p class="font-mono text-xs uppercase tracking-wider text-mist">
          Durban, KwaZulu-Natal, South Africa
        </p>
        <a
          href="https://wa.me/27611519561"
          class="font-mono text-xs uppercase tracking-wider text-mist hover:text-signal"
        >
          +27 61 151 9561
        </a>
        <a
          href="mailto:continuumdataguardtech@outlook.com"
          class="font-mono text-xs uppercase tracking-wider text-mist hover:text-signal"
        >
          continuumdataguardtech@outlook.com
        </a>
      </div>
    </div>

    <nav aria-label="Sitemap">
      <ul class="flex flex-col gap-3">
        {siteMap.map((item) => (
          <li>
            <a
              href={item.href}
              class="font-mono text-xs uppercase tracking-wider text-mist hover:text-signal"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </Container>

  <Container class="border-t border-border py-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-xs text-fog">
        &copy; {currentYear} Continuum Dataguard Technologies. All rights reserved.
      </p>
      <nav aria-label="Legal">
        <ul class="flex gap-6">
          {legal.map((item) => (
            <li>
              <a
                href={item.href}
                class="font-mono text-xs uppercase tracking-wider text-mist hover:text-signal"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </Container>
</footer>
