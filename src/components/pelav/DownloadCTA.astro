---
import Button from '../ui/Button.astro';
import { playStoreUrl } from '../../data/pelav';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{playStoreUrl ? (
  <Button href={playStoreUrl} target="_blank" rel="noopener noreferrer" class={className}>
    Get PELAV™ on Google Play
  </Button>
) : (
  <button
    type="button"
    disabled
    aria-disabled="true"
    class:list={[
      'inline-flex items-center justify-center gap-2 rounded-xs px-6 py-3 font-mono text-sm uppercase tracking-wide border border-border-strong text-fog cursor-not-allowed opacity-60',
      className,
    ]}
  >
    Coming Soon — Google Play
  </button>
)}
