---
interface Pillar {
  number: string;
  name: string;
  description: string;
}

// This component has no h2 of its own — it assumes the calling page supplies
// an h2 immediately before it, so these h3 pillar names nest correctly.
const pillars: Pillar[] = [
  {
    number: '01',
    name: 'Data & Intelligence',
    description:
      'Converting operational and business data into intelligence that supports decision-making, measurement and performance improvement.',
  },
  {
    number: '02',
    name: 'Business Strategy',
    description:
      'Connecting strategic intent to organisational capability, operating performance and measurable execution.',
  },
  {
    number: '03',
    name: 'Digital Implementation',
    description:
      'Translating business requirements and strategy into practical digital systems, workflows and technology.',
  },
  {
    number: '04',
    name: 'Organisational Development',
    description:
      'Building organisational readiness — leadership, capability, operating models and change adoption — to sustain transformation.',
  },
];
---

<ul class="pillar-grid grid grid-cols-1 sm:grid-cols-2" role="list">
  {pillars.map((pillar) => (
    <li class="pillar-cell border-border px-6 py-10 sm:px-10 sm:py-14">
      <span class="block font-mono text-xs uppercase tracking-wider text-signal" aria-hidden="true">
        {pillar.number}
      </span>
      <h3 class="mt-4 text-2xl text-paper">{pillar.name}</h3>
      <p class="mt-3 text-sm text-fog">{pillar.description}</p>
    </li>
  ))}
</ul>

<style>
  .pillar-cell {
    border-style: solid;
    border-width: 0;
  }

  .pillar-cell:nth-child(-n + 3) {
    border-bottom-width: 1px;
  }

  @media (min-width: 640px) {
    .pillar-cell:nth-child(3) {
      border-bottom-width: 0;
    }

    .pillar-cell:nth-child(odd) {
      border-right-width: 1px;
    }
  }
</style>
