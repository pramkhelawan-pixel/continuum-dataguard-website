---
const nodes = [
  'People',
  'Data',
  'Technology',
  'Process',
  'Engineering',
  'Security',
  'Governance',
  'Measurement',
  'Continuous Improvement',
];

const size = 560;
const center = size / 2;
const radius = 220;

const points = nodes.map((label, i) => {
  const angle = (i / nodes.length) * Math.PI * 2 - Math.PI / 2;
  return {
    label,
    x: center + radius * Math.cos(angle),
    y: center + radius * Math.sin(angle),
  };
});

const connections: Array<[number, number]> = [];
for (let i = 0; i < points.length; i += 1) {
  for (let j = i + 1; j < points.length; j += 1) {
    connections.push([i, j]);
  }
}
---

<div class="node-graph">
  <svg
    viewBox={`0 0 ${size} ${size}`}
    role="img"
    aria-label="System diagram showing People, Data, Technology, Process, Engineering, Security, Governance, Measurement, and Continuous Improvement as an interconnected system"
  >
    {connections.map(([a, b]) => (
      <line
        x1={points[a].x}
        y1={points[a].y}
        x2={points[b].x}
        y2={points[b].y}
        class="connection"
      />
    ))}
    {points.map((point) => (
      <g class="graph-node" transform={`translate(${point.x}, ${point.y})`}>
        <circle r="6" class="node-dot" />
        <text class="node-label" text-anchor="middle" dy="-14">
          {point.label}
        </text>
      </g>
    ))}
  </svg>
</div>

<style>
  .node-graph svg {
    width: 100%;
    height: auto;
  }

  .connection {
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .node-dot {
    fill: var(--color-signal);
  }

  .node-label {
    fill: var(--color-mist);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
