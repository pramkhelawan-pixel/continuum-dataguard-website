---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  aria-hidden="true"
  class:list={['pointer-events-none absolute inset-0 overflow-hidden', className]}
>
  <div class="grid-lines"></div>
  <span class="corner-bracket corner-bracket--tl"></span>
  <span class="corner-bracket corner-bracket--tr"></span>
  <span class="corner-bracket corner-bracket--bl"></span>
  <span class="corner-bracket corner-bracket--br"></span>
</div>

<style>
  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--color-border) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-border) 1px, transparent 1px);
    background-size: calc(var(--grid-unit) * 6) calc(var(--grid-unit) * 6);
    opacity: 0.35;
  }

  .corner-bracket {
    position: absolute;
    width: calc(var(--grid-unit) * 3);
    height: calc(var(--grid-unit) * 3);
    opacity: 0.6;
  }

  .corner-bracket--tl {
    top: calc(var(--grid-unit) * 2);
    left: calc(var(--grid-unit) * 2);
    border-top: var(--grid-line-width) solid var(--color-signal);
    border-left: var(--grid-line-width) solid var(--color-signal);
  }

  .corner-bracket--tr {
    top: calc(var(--grid-unit) * 2);
    right: calc(var(--grid-unit) * 2);
    border-top: var(--grid-line-width) solid var(--color-signal);
    border-right: var(--grid-line-width) solid var(--color-signal);
  }

  .corner-bracket--bl {
    bottom: calc(var(--grid-unit) * 2);
    left: calc(var(--grid-unit) * 2);
    border-bottom: var(--grid-line-width) solid var(--color-signal);
    border-left: var(--grid-line-width) solid var(--color-signal);
  }

  .corner-bracket--br {
    bottom: calc(var(--grid-unit) * 2);
    right: calc(var(--grid-unit) * 2);
    border-bottom: var(--grid-line-width) solid var(--color-signal);
    border-right: var(--grid-line-width) solid var(--color-signal);
  }
</style>
