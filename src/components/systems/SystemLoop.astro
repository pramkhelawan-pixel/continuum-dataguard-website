---
interface Stage {
  label: string;
}

const stages: Stage[] = [
  { label: 'Observe' },
  { label: 'Diagnose' },
  { label: 'Engineer' },
  { label: 'Secure' },
  { label: 'Verify' },
  { label: 'Improve' },
];

const size = 480;
const center = size / 2;
const radius = 190;
const nodeRadius = 34;

const points = stages.map((stage, i) => {
  const angle = (i / stages.length) * Math.PI * 2 - Math.PI / 2;
  const x = center + radius * Math.cos(angle);
  const y = center + radius * Math.sin(angle);
  return { label: stage.label, x, y };
});
---

<div class="system-loop">
  <svg
    viewBox={`0 0 ${size} ${size}`}
    role="img"
    aria-label="The Continuum systems loop: Observe, Diagnose, Engineer, Secure, Verify, Improve"
  >
    <circle cx={center} cy={center} r={radius} class="loop-path" />
    {points.map((point) => (
      <g class="loop-node" transform={`translate(${point.x}, ${point.y})`}>
        <circle r={nodeRadius} class="node-circle" />
        <text class="node-label" text-anchor="middle" dominant-baseline="middle">
          {point.label}
        </text>
      </g>
    ))}
  </svg>
</div>

<style>
  .system-loop svg {
    width: 100%;
    height: auto;
  }

  .loop-path {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .node-circle {
    fill: var(--color-surface);
    stroke: var(--color-signal);
    stroke-width: 1.5;
  }

  .node-label {
    fill: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
