---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Badge from '../components/ui/Badge.astro';
import { pelavLegal } from '../data/pelav';

// Covers the website only; the PELAV™ app's own documents are linked, never
// restated. The three disclaimer ids are kept for existing links to them.
const pelavTerms = pelavLegal.terms;
const pelavSafety = pelavLegal.safety;
---

<Layout title="Terms of Use" description="Terms governing use of the Continuum Dataguard Technologies website, with links to the PELAV™ app's own Terms and Conditions.">
  <Header slot="header" />

  <Section>
    <Container class="max-w-3xl">
      <Badge>Terms of Use</Badge>
      <h1 class="mt-6 text-4xl text-paper">Terms of Use</h1>
      <p class="mt-3 font-mono text-sm text-mist">Last updated 13 October 2026</p>
      <p class="mt-6 text-mist">
        These Terms of Use govern your use of the Continuum Dataguard Technologies website. By
        using the website, you agree to these terms.
      </p>

      <div class="mt-12 flex flex-col gap-10">
        <div>
          <h2 class="text-2xl text-paper">The PELAV™ app has its own terms</h2>
          <p class="mt-3 text-mist">
            These terms do not cover the PELAV™ app. Your use of PELAV™ is governed only by the
            PELAV™ legal documents:
          </p>
          <ul class="mt-3 flex flex-col gap-2 text-mist">
            <li><a href={pelavTerms} class="text-paper hover:text-signal">PELAV™ Terms and Conditions</a></li>
            <li><a href={pelavLegal.privacy} class="text-paper hover:text-signal">PELAV™ Privacy Policy</a></li>
            <li><a href={pelavSafety} class="text-paper hover:text-signal">PELAV™ Safety and Disclaimers</a></li>
            <li><a href={pelavLegal.dataSources} class="text-paper hover:text-signal">PELAV™ Data Sources and Attribution</a></li>
            <li><a href={pelavLegal.accountDeletion} class="text-paper hover:text-signal">Delete your PELAV™ account</a></li>
          </ul>
          <p class="mt-3 text-mist">
            PELAV™ is a product of Continuum Dataguard Technologies, not a separate company.
          </p>
        </div>

        <div>
          <h2 id="marine-fishing-disclaimer" class="text-2xl text-paper">PELAV™ marine and fishing information</h2>
          <p class="mt-3 text-mist">
            The disclaimers for PELAV™'s weather, marine, tide, solunar, readiness,
            recommendation and species information are in the
            <a href={pelavSafety} class="text-paper hover:text-signal">PELAV™ Safety and Disclaimers</a>
            notice and the <a href={pelavTerms} class="text-paper hover:text-signal">PELAV™ Terms and Conditions</a>.
          </p>
        </div>

        <div>
          <h2 id="licence-vault-disclaimer" class="text-2xl text-paper">PELAV™ Digital Fishing Licence Vault</h2>
          <p class="mt-3 text-mist">
            The terms for the Licence Vault are in the
            <a href={pelavTerms} class="text-paper hover:text-signal">PELAV™ Terms and Conditions</a>
            and the <a href={pelavSafety} class="text-paper hover:text-signal">PELAV™ Safety and Disclaimers</a> notice.
          </p>
        </div>

        <div>
          <h2 id="length-to-weight-disclaimer" class="text-2xl text-paper">PELAV™ Length-to-Weight Calculator</h2>
          <p class="mt-3 text-mist">
            The Length-to-Weight Calculator is not available in this version of the app. The
            disclaimer for the calculator's estimates in app versions 1.3.0 and older is in the
            <a href={pelavSafety} class="text-paper hover:text-signal">PELAV™ Safety and Disclaimers</a> notice.
          </p>
        </div>

        <div>
          <h2 class="text-2xl text-paper">Use of this website</h2>
          <p class="mt-3 text-mist">
            This website provides general information about Continuum Dataguard Technologies, its
            consulting practice and its products. You may use it for lawful purposes only.
          </p>
        </div>

        <div>
          <h2 class="text-2xl text-paper">Intellectual property</h2>
          <p class="mt-3 text-mist">
            Unless otherwise indicated, the content, design and branding of this website are the
            property of Continuum Dataguard Technologies. You may not reproduce, distribute or
            otherwise use this content without prior permission.
          </p>
        </div>

        <div>
          <h2 class="text-2xl text-paper">Website information</h2>
          <p class="mt-3 text-mist">
            Content on this website is general information and does not constitute professional,
            legal or financial advice. While we take reasonable care to keep it accurate and up
            to date, we do not guarantee its completeness or accuracy.
          </p>
        </div>

        <div>
          <h2 class="text-2xl text-paper">External links</h2>
          <p class="mt-3 text-mist">
            Links to third-party websites are provided for convenience only. Continuum Dataguard
            Technologies does not control and is not responsible for the content or practices of
            any third-party website.
          </p>
        </div>

        <div>
          <h2 class="text-2xl text-paper">Limitation of liability</h2>
          <p class="mt-3 text-mist">
            To the maximum extent permitted by law, Continuum Dataguard Technologies shall not be
            liable for any loss or damage arising from your use of, or inability to use, this
            website.
          </p>
        </div>

        <div>
          <h2 class="text-2xl text-paper">Availability and changes</h2>
          <p class="mt-3 text-mist">
            We do not guarantee that this website will be available at all times or free from
            interruption. We may change its content, or these Terms of Use, at any time; the date
            at the top of this page shows when they last changed.
          </p>
        </div>

        <div>
          <h2 class="text-2xl text-paper">Governing law</h2>
          <p class="mt-3 text-mist">
            These Terms of Use are governed by the laws of the Republic of South Africa. Any
            disputes arising from your use of the website will be subject to the jurisdiction of
            the South African courts.
          </p>
        </div>

        <div>
          <h2 class="text-2xl text-paper">Contact</h2>
          <div class="mt-4 flex flex-col gap-2">
            <p class="font-mono text-sm text-paper">Continuum Dataguard Technologies</p>
            <p class="font-mono text-sm text-mist">Registration number 2026/247252/07</p>
            <p class="font-mono text-sm text-mist">Durban, KwaZulu-Natal, South Africa</p>
            <a href="mailto:admin@continuumdataguardtech.co.za" class="font-mono text-sm text-paper hover:text-signal">
              admin@continuumdataguardtech.co.za
            </a>
            <a href="https://wa.me/27611519561" class="font-mono text-sm text-paper hover:text-signal">
              WhatsApp: +27 61 151 9561
            </a>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Footer slot="footer" />
</Layout>
