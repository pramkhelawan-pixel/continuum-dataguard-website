---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Badge from '../components/ui/Badge.astro';
---

<Layout title="Contact" description="Contact Continuum Dataguard Technologies.">
  <Header slot="header" />

  <Section>
    <Container class="max-w-2xl">
      <Badge>Contact</Badge>
      <h1 class="mt-6 text-4xl text-paper">Start a conversation</h1>
      <p class="mt-6 text-mist">
        If you are working through a business, data, digital implementation, or
        organisational-development challenge, contact Continuum directly.
      </p>

      <div class="mt-12 flex flex-col gap-8">
        <div>
          <p class="font-mono text-xs uppercase tracking-wider text-mist">WhatsApp</p>
          <a href="https://wa.me/27611519561" class="mt-2 block text-xl text-paper hover:text-signal">
            +27 61 151 9561
          </a>
        </div>

        <div>
          <p class="font-mono text-xs uppercase tracking-wider text-mist">Email</p>
          <a
            href="mailto:continuumdataguardtech@outlook.com"
            class="mt-2 block text-xl text-paper hover:text-signal"
          >
            continuumdataguardtech@outlook.com
          </a>
        </div>

        <div>
          <p class="font-mono text-xs uppercase tracking-wider text-mist">Location</p>
          <p class="mt-2 text-xl text-paper">Durban, KwaZulu-Natal, South Africa</p>
        </div>
      </div>
    </Container>
  </Section>

  <Footer slot="footer" />
</Layout>
