---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Badge from '../components/ui/Badge.astro';
import { pelavLegal } from '../data/pelav';

// Covers the website only; the PELAV™ app's own documents are linked, never restated.
---

<Layout title="Privacy Policy" description="How Continuum Dataguard Technologies handles personal information collected through this website, with links to the PELAV™ app's own Privacy Policy.">
  <Header slot="header" />

  <Section>
    <Container class="max-w-3xl">
      <Badge>Privacy Policy</Badge>
      <h1 class="mt-6 text-4xl text-paper">Privacy Policy</h1>
      <p class="mt-3 font-mono text-sm text-mist">Last updated 14 October 2026</p>
      <p class="mt-6 text-mist">
        This Privacy Policy explains how Continuum Dataguard Technologies ("Continuum", "we",
        "us") handles personal information in connection with this website.
      </p>

      <div class="mt-12 flex flex-col gap-10">
        <div>
          <h2 class="text-2xl text-paper">Our apps have their own policies</h2>
          <p class="mt-3 text-mist">
            This policy does not cover our apps. Each app has its own Privacy Policy, which is
            the only statement of how that app handles personal information:
          </p>
          <ul class="mt-3 flex flex-col gap-2 text-mist">
            <li>
              PELAV™:
              <a href={pelavLegal.privacy} class="text-paper hover:text-signal">Privacy Policy</a>
              and <a href={pelavLegal.accountDeletion} class="text-paper hover:text-signal">how to delete your PELAV™ account</a>
            </li>
            <li>
              PELAV PDF Scanner:
              <a href="/pelav-pdf-scanner/privacy" class="text-paper hover:text-signal">Privacy Policy</a>
            </li>
          </ul>
        </div>

        <div>
          <h2 class="text-2xl text-paper">Who is responsible</h2>
          <p class="mt-3 text-mist">
            Continuum Dataguard Technologies, registration number 2026/247252/07, Durban,
            KwaZulu-Natal, South Africa. Information Officer: Pranesh Ramkhelawan
            (<a href="mailto:enzo@continuumdataguardtech.co.za" class="text-paper hover:text-signal">enzo@continuumdataguardtech.co.za</a>).
          </p>
        </div>

        <div>
          <h2 class="text-2xl text-paper">Information you send us</h2>
          <p class="mt-3 text-mist">
            This website has no contact form and no accounts. It shows an email address and a
            WhatsApp number so you can contact us yourself. If you do, we receive what you choose
            to send, such as your name, email address or phone number and your message, and use it
            only to respond to you. We do not share it except as needed to respond or as required
            by law.
          </p>
        </div>

        <div>
          <h2 class="text-2xl text-paper">Website hosting and technical information</h2>
          <p class="mt-3 text-mist">
            This website is hosted on GitHub Pages. As with most websites, the host automatically
            processes standard technical information, such as your IP address, browser type and
            access times, to deliver the pages. We do not use this information to identify
            visitors. GitHub may process it outside South Africa.
          </p>
        </div>

        <div>
          <h2 class="text-2xl text-paper">Cookies</h2>
          <p class="mt-3 text-mist">
            This website does not use cookies, analytics or tracking technologies. If this
            changes, we will update this policy first.
          </p>
        </div>

        <div>
          <h2 class="text-2xl text-paper">How long we keep it</h2>
          <p class="mt-3 text-mist">
            Messages you send us are kept only for as long as reasonably necessary to respond to
            you, and then deleted.
          </p>
        </div>

        <div>
          <h2 class="text-2xl text-paper">Your rights</h2>
          <p class="mt-3 text-mist">
            Under the Protection of Personal Information Act (POPIA) you can ask whether we hold
            personal information about you, and ask us to correct or delete it. Contact us using
            the details below. You also have the right to lodge a complaint with the
            <a href="https://inforegulator.org.za" class="text-paper hover:text-signal">Information Regulator</a>.
          </p>
        </div>

        <div>
          <h2 class="text-2xl text-paper">Children</h2>
          <p class="mt-3 text-mist">
            This website is not directed at children, and we do not knowingly collect personal
            information from children.
          </p>
        </div>

        <div>
          <h2 class="text-2xl text-paper">Contact</h2>
          <div class="mt-4 flex flex-col gap-2">
            <p class="font-mono text-sm text-paper">Continuum Dataguard Technologies</p>
            <p class="font-mono text-sm text-mist">Durban, KwaZulu-Natal, South Africa</p>
            <a href="mailto:admin@continuumdataguardtech.co.za" class="font-mono text-sm text-paper hover:text-signal">
              admin@continuumdataguardtech.co.za
            </a>
            <a href="https://wa.me/27611519561" class="font-mono text-sm text-paper hover:text-signal">
              WhatsApp: +27 61 151 9561
            </a>
          </div>
        </div>

        <div>
          <h2 class="text-2xl text-paper">Changes to this policy</h2>
          <p class="mt-3 text-mist">
            When we change this policy we update the date at the top of this page.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <Footer slot="footer" />
</Layout>
